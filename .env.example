# .env.example — схема. Рабочие значения — в ~/.config/ai/env/news.env,
# в проекте `.env` — симлинк на него (см. ../../docs/ENVIRONMENT.md).
# Не копируйте этот файл поверх симлинка: сначала проверьте `ls -l .env`.

# DeepSeek (anthropic-совместимый эндпоинт, iter-19 2026-09-30; pay-as-you-go
# баланс на platform.deepseek.com). deepseek-flash = DeepSeek-V4.1-Flash
# (легаси-имена deepseek-v4-flash* тоже принимаются, но роутятся на V4.1).
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-flash
# Режим мышления: сырой JSON поля thinking в payload (пусто = не слать).
# У DeepSeek thinking ВКЛЮЧЁН ПО УМОЛЧАНИЮ — служебные вызовы (gist/chat)
# отключают его явно (thinking=False → {"type":"disabled"}, iter-19).
# budget_tokens DeepSeek игнорирует — усилие задаётся LLM_EFFORT.
LLM_THINKING={"type":"enabled"}
# Усилие мышления mega-вызова → output_config.effort: low/high/max
# (по решению пользователя 2026-09-30 — max). Пусто = не слать (дефолт API: high).
# iter-20 (2026-10-01): вторая попытка после обрезки идёт с effort=high
# (ретрай-лестница bot/llm.py) — max на плотном входе требует 55-65k
# выходных токенов, повтор с тем же усилием не помогает.
LLM_EFFORT=max
# Бюджет генерации дайджеста: thinking съедает часть (12-16К симв. текста).
# 2026-09-23: flash мыслил ПОВЕРХ budget_tokens — 32000 выходных токенов,
# текст пуст/обрезан. iter-20: 64000 оказалось впритык — реплей боевого
# входа дал 54785 выходных токенов на effort=max (инцидент 2026-10-01:
# обрез на 64000, сводка не пришла) → 96000. Потолок модели — 384K.
LLM_MAX_TOKENS=96000

# Telegram-бот (пусто = mock-режим: сводка в stdout + digests/)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Второй (dev/тестовый) бот — использовался в итерациях 1-6 (D24). После
# миграции агента на `python3 -m bot` (И7) держать ПУСТЫМ: бот берёт
# TELEGRAM_TOKEN (config.py: непустой DEV приоритетнее прод-токена).
TELEGRAM_TOKEN_DEV=

# Расписание сводок старого pipeline-бота (rollback-вариант, через запятую)
DIGEST_TIMES=09:00,21:00

# iter-11 (mega-digest, 2026-09-15): непрерывный сбор, объёмы, retention.
# ВНИМАНИЕ: эти BOT_* читает Python-контур (bot/), это путь отката.
# Текущий прод (tgcloud/) берёт настройки из tgcloud/lib/settings.js,
# а из .env — только токены/LLM через scripts/build-config.mjs.
BOT_COLLECT_INTERVAL=1800     # сек между фоновыми сборами (D44)
BOT_COLLECT_WORKERS=6         # пул потоков сбора (tgweb всё равно последовательно)
BOT_DIGEST_PER_SOURCE=15      # per-source бюджет дельты (окно ROW_NUMBER)
BOT_DIGEST_MAX_ITEMS=800      # общий кап входа дайджеста (1М контекст модели)
BOT_DIGEST_MAX_CHARS=600000   # кап входа по символам (iter-21: 800 пунктов давали ~1 МБ)
BOT_MAX_SOURCES=100           # лимит источников на чат (D46)
BOT_RETENTION_ITEMS_DAYS=10   # жизнь items + надгробия в seen_hashes (D47)
BOT_RETENTION_DAYS=30         # жизнь digests/chat_history/seen_hashes
BOT_RETENTION_INTERVAL=21600  # сек между проходами retention (по умолчанию 6 ч)

# iter-18: Reddit OAuth — Reddit блокирует .rss с датацентр/VPN-IP на уровне
# сети (403 Blocked/429). Приложение создаётся на https://www.reddit.com/prefs/apps
# (тип script). Пусто — прежний путь .rss (на домашнем IP обычно работает).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=personal-news-digest/1.0

# М2: Supabase Postgres (transaction pooler, порт 6543, регион проекта —
# aws-1-eu-west-1; direct-хост db.*.supabase.co — IPv6-only, не используется).
# Задан → бот работает на PG вместо sqlite (bot.db остаётся локальным
# архивом/путём отката). BOT_DB_PATH (если задан) принудительно возвращает
# sqlite — используют тесты.
SUPABASE_DB_URL=
# М2: PG для тестов (bot/db.py трактует ':memory:' как временную схему здесь):
# локально — docker `postgres:16-alpine` на 127.0.0.1:54329, в CI — service
# container. Не указывай сюда боевой Supabase — тесты создают сотни схем.
BOT_TEST_PG_URL=

# ─── Наследие удалённого GitHub-воркера (не используется Serverless-версией) ──
# Оставлены в .env для истории; текущий tgcloud-код их не читает.
# GITHUB_REPO=
# GITHUB_DISPATCH_TOKEN=
# GITHUB_REF=
