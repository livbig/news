# Z.ai (anthropic-совместимый эндпоинт — покрывается подпиской GLM Coding Plan;
# для pay-as-you-go баланса можно OpenAI-совместимый https://api.z.ai/api/paas/v4,
# но тогда llm.py нужно вернуть на /chat/completions)
LLM_API_KEY=
LLM_BASE_URL=https://api.z.ai/api/anthropic
LLM_MODEL=glm-5.3

# Telegram-бот (пусто = mock-режим: сводка в stdout + digests/)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Второй (dev/тестовый) бот — использовался в итерациях 1-6 (D24). После
# миграции агента на `python3 -m bot` (И7) держать ПУСТЫМ: бот берёт
# TELEGRAM_TOKEN (config.py: непустой DEV приоритетнее прод-токена).
TELEGRAM_TOKEN_DEV=

# Расписание сводок старого pipeline-бота (rollback-вариант, через запятую)
DIGEST_TIMES=09:00,21:00

# М2: Supabase Postgres (transaction pooler, порт 6543, регион проекта —
# aws-1-eu-west-1; direct-хост db.*.supabase.co — IPv6-only, не используется).
# Задан → бот работает на PG вместо sqlite (bot.db остаётся локальным
# архивом/путём отката). BOT_DB_PATH (если задан) принудительно возвращает
# sqlite — используют тесты.
SUPABASE_DB_URL=
# М2: PG для тестов (bot/db.py трактует ':memory:' как временную схему здесь):
# локально — docker `postgres:16-alpine` на 127.0.0.1:54329, в CI — service
# container. Не указывай сюда боевой Supabase — тесты создают сотни схем.
BOT_TEST_PG_URL=
