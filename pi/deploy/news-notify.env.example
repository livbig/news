# Значения берутся из ~/.config/ai/env/news.env на Mac и кладутся deploy.sh в /etc/news/news.env
NEWS_BOT_TOKEN=
NEWS_CHAT_ID=
NEWS_TZ_OFFSET_MIN=180
NEWS_DIGEST_TIMES=09:00,21:00
NEWS_COLLECT_INTERVAL_MIN=20
NEWS_ANALYZE_EVERY_MIN=10
NEWS_ANALYZE_BATCH=15
NEWS_MAX_PAGES_PER_CHANNEL=6
NEWS_API_PORT=8097
NEWS_API_HOST=0.0.0.0
NEWS_API_TOKEN=
NEWS_DB=/srv/news/data/news.db
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-flash
LLM_EFFORT=max
LLM_THINKING=enabled
LLM_MAX_TOKENS=96000
# Голосовые в чате (OpenRouter STT)
OPENROUTER_API_KEY=
STT_BASE_URL=https://openrouter.ai/api/v1
STT_MODEL=openai/whisper-large-v3
STT_LANGUAGE=ru
