# Схема окружения. Рабочие значения — в ~/.config/ai/env/pi-telegram-bridge.env;
# в проекте `.env` — симлинк на него (см. ../../docs/ENVIRONMENT.md).
# Токен от @BotFather: /newbot → скопировать токен.
PI_TG_BOT_TOKEN=

# Кому можно писать боту (ваш Telegram user id). Если пусто — бот спарится
# с первым, кто отправит ему /start. Узнать id: /chatid в чате с ботом.
PI_TG_ALLOWED_USER_ID=

# Каталог по умолчанию для новых сессий pi (по умолчанию — cwd процесса).
# PI_TG_CWD=/Users/you/project

# Где хранится состояние (маппинг чат → сессия).
# PI_TG_STATE_FILE=~/.pi/agent/pi-telegram-bridge/state.json

# Каталог файлов ассистента (по умолчанию /srv/assistant/data).
# outbox — файлы, которые агент отдаёт маркером [file:/путь]; inbox — принятые из Telegram.
# PI_TG_DATA_DIR=/srv/assistant/data

# Текстовые логи моста (`bridge-YYYY-MM-DD.txt`, 14 дней) и отметка `bridge-heartbeat.json`,
# по которой сторож в ассистенте видит, что мост жив. По умолчанию — <PI_TG_DATA_DIR>/logs.
# PI_TG_LOG_DIR=/srv/assistant/data/logs

# Контекст сообщения агенту (PI_CHAT_ID, PI_CHAT_TYPE, PI_USER_ID, PI_USER_NAME, PI_THREAD_ID)
# мост ставит сам из апдейта: по нему напоминание приходит туда, где его попросили.
# Руками эти переменные не задаются.

# Корень Bot API. Меняется только для локального сервера (e2e-тесты): по нему же скачиваются
# входящие файлы, поэтому в бою должно остаться api.telegram.org.
# PI_TG_API_ROOT=https://api.telegram.org

# Путь к CLI pi, если автопоиск не сработал.
# PI_TG_CLI_PATH=/path/to/node_modules/@earendil-works/pi-coding-agent/dist/cli.js

# Доп. флаги дочернего `pi --mode rpc`, например --approve для доверия проекту.
# Доп. флаги дочернего pi: пусто — все встроенные инструменты (bash/edit/write/MCP) доступны.
# PI_TG_PI_ARGS=--approve

# Поток драфтов: auto (по умолчанию) | off (сразу editMessageText).
# PI_TG_DRAFT=auto

# Rich Messages (Bot API 10.1+): auto (по умолчанию) — Telegram рендерит markdown сам и даёт
# кнопку «стоп» в клиенте; off — классический путь (черновик + HTML-разметка моста).
# PI_TG_RICH=auto

# separate (по умолчанию) — каждая тема форума = своя сессия; shared — все темы ведут в одну.
# PI_TG_THREADS=separate

# Сколько ждать событий от pi, прежде чем напомнить в чате «нет событий» (мс, 900000).
# Это не потолок хода: он задаётся PI_TG_TURN_MAX_MS.
# PI_TG_TIMEOUT_MS=900000

# Сколько простаивает процесс pi, прежде чем его погасить (мс, по умолчанию 1800000).
# Процессы поднимаются по одному на сессию; /status показывает их число.
# PI_TG_IDLE_MS=1800000

# Сколько бездействующих процессов держать, прежде чем гасить самые старые.
# PI_TG_MAX_IDLE_SESSIONS=3

# Жёсткий потолок одновременных процессов pi (по умолчанию 4). На Raspberry Pi 4 ГБ
# ставьте 3: каждый процесс — это память и расширения.
# PI_TG_MAX_PROCESSES=4

# Абсолютный потолок хода, мс (по умолчанию 1200000 = 20 минут). Дольше — ход прерывается,
# процесс гасится; следующее сообщение поднимает свежий.
# PI_TG_TURN_MAX_MS=1200000

# Жёсткий потолок стоимости одного прогона в долларах (по умолчанию 2). Расход берётся из pi
# (getSessionStats().cost, разница с расходом до хода). Перебор — прогон прерывается, процесс
# гасится, в чат уходит «остановил себя: прогон стоил больше $2», факт пишется в лог.
# PI_TG_TURN_MAX_COST_USD=2

# В группах реагировать только на @бот или ответ на его сообщение (по умолчанию true).
# Команды (/...) разрешены всегда. false — отвечать на всё.
# PI_TG_REQUIRE_MENTION=true

# Голосовые: распознавание через OpenRouter STT (встроенный fetch, без зависимостей).
# Без ключа бот честно скажет, что голос не настроен.
# OPENROUTER_API_KEY=
# STT_MODEL=openai/whisper-large-v3
# STT_BASE_URL=https://openrouter.ai/api/v1
# STT_LANGUAGE=ru

# debug | info | warn | error | silent
# PI_TG_LOG=info

# Локальный API ассистента (Mini App и HTTPS-туннель отключены): меню «Проекты» читает
# объекты и сметы с того же Pi. Токен уходит заголовком x-service-token.
# MINIAPP_API_URL=http://127.0.0.1:8088
# MINIAPP_SERVICE_TOKEN=
