{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python",
      "config": { "maxDuration": 300 } }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html",
      "headers": { "Cache-Control": "no-store" } },
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
